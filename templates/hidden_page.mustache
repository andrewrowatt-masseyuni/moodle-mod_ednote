{{!
    @template mod_ednote/hidden_page

    The teacher notes the current user has hidden, and the links to show them again.

    Every Show link is a plain GET carrying a sesskey, so this page needs no JavaScript - it is the
    fallback for a note that has already vanished from the course page.

    Context variables required for this template:
    * courseurl string
    * hasany bool
    * hasnotes bool
    * notes array - name, showurl
    * hasguidance bool
    * guidance array - name, showurl

    Example context (json):
    {
        "courseurl": "https://moodle.local/course/view.php?id=2",
        "hasany": true,
        "hasnotes": true,
        "notes": [{"name": "Reflective journal guidance", "showurl": "#"}],
        "hasguidance": true,
        "guidance": [{"name": "Reflective journal", "showurl": "#"}]
    }
}}
<div class="ednote-hidden-page">
    {{^hasany}}
        <p class="text-muted">{{#str}} hiddennone, mod_ednote {{/str}}</p>
    {{/hasany}}

    {{#hasnotes}}
        <h3 class="h5">{{#str}} hiddennotes, mod_ednote {{/str}}</h3>
        <ul class="list-group mb-4">
            {{#notes}}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>{{name}}</span>
                    <a class="btn btn-secondary btn-sm" href="{{showurl}}">{{#str}} show, mod_ednote {{/str}}</a>
                </li>
            {{/notes}}
        </ul>
    {{/hasnotes}}

    {{#hasguidance}}
        <h3 class="h5">{{#str}} hiddenguidance, mod_ednote {{/str}}</h3>
        <p class="text-muted small">{{#str}} hiddenguidance_desc, mod_ednote {{/str}}</p>
        <ul class="list-group mb-4">
            {{#guidance}}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>{{name}}</span>
                    <a class="btn btn-secondary btn-sm" href="{{showurl}}">{{#str}} show, mod_ednote {{/str}}</a>
                </li>
            {{/guidance}}
        </ul>
    {{/hasguidance}}

    <a href="{{courseurl}}">{{#str}} backtocourse, mod_ednote {{/str}}</a>
</div>
